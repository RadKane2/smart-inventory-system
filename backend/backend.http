@baseUrl = http://localhost:5093

### Register customer
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test Customer",
  "email": "customer@test.com",
  "password": "TestPassword123!"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "customer2@test.com",
  "password": "TestPassword123!"
}

@baseUrl = http://localhost:5093
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..nUoaDcMnJhd0-2muZ5x6pB32M1EiXiVu3GpHBYWANMY

### Endpoint para cualquier usuario autenticado
GET {{baseUrl}}/api/test/authenticated
Authorization: Bearer {{token}}

### Endpoint exclusivo para Customer
GET {{baseUrl}}/api/test/customer
Authorization: Bearer {{token}}

### Endpoint exclusivo para Admin
GET {{baseUrl}}/api/test/admin
Authorization: Bearer {{token}}

@baseUrl = http://localhost:5093
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..nUoaDcMnJhd0-2muZ5x6pB32M1EiXiVu3GpHBYWANMY

### Get all categories - Public
GET {{baseUrl}}/api/categories

### Get category by ID - Public
GET {{baseUrl}}/api/categories/1

### Create category - Admin
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic devices and accessories."
}

### Update category - Admin
PUT {{baseUrl}}/api/categories/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Electronic Products",
  "description": "Computers, devices and electronic accessories."
}

### Delete category - Admin
DELETE {{baseUrl}}/api/categories/1
Authorization: Bearer {{adminToken}}

@baseUrl = http://localhost:5093
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..nUoaDcMnJhd0-2muZ5x6pB32M1EiXiVu3GpHBYWANMY

### Create category
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic products and accessories."
}

### Get public products
GET {{baseUrl}}/api/products

### Search products
GET {{baseUrl}}/api/products?search=mouse

### Filter products by category
GET {{baseUrl}}/api/products?categoryId=1

### Create product - Admin
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "description": "Ergonomic wireless mouse.",
  "price": 599.90,
  "minimumStock": 5,
  "categoryId": 1,
  "imageUrl": "https://example.com/images/mouse.jpg"
}

### Get product by ID
GET {{baseUrl}}/api/products/1

### Update product - Admin
PUT {{baseUrl}}/api/products/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Wireless Mouse Pro",
  "description": "Ergonomic wireless mouse with rechargeable battery.",
  "price": 749.90,
  "minimumStock": 5,
  "categoryId": 1,
  "imageUrl": "https://example.com/images/mouse-pro.jpg",
  "status": "Active"
}

### Get all products including inactive - Admin
GET {{baseUrl}}/api/products/admin
Authorization: Bearer {{adminToken}}

### Deactivate product - Admin
DELETE {{baseUrl}}/api/products/1
Authorization: Bearer {{adminToken}}